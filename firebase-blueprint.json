          "format": "date-time"
        }
      },
      "required": ["userId", "points", "tier", "redeemedPoints", "updatedAt"]
    },
    "LiveStream": {
      "title": "LiveStream",
      "description": "Seller live shopping demonstration stream.",
      "type": "object",
      "properties": {
        "traderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "status": {
          "type": "string",
          "enum": ["Live", "Upcoming", "Ended"]
        },
        "liveDiscountPct": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["traderId", "businessName", "title", "status", "liveDiscountPct", "createdAt"]
    },
    "LiveStreamMessage": {
      "title": "LiveStreamMessage",
      "description": "Live Q&A comment posted during a livestream.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "senderName", "text", "createdAt"]
    },
    "FraudAlert": {
      "title": "FraudAlert",
      "description": "Admin-managed fraud review alert.",
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "enum": ["Order", "Listing", "Review"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "riskLevel": {
          "type": "string",
          "enum": ["Low", "Medium", "High"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "resolved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["targetType", "targetId", "title", "riskLevel", "reason", "resolved", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Authorized admin accounts collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public storefront profile for customers and traders."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII document isolated from public profile reads."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Marketplace product catalog."
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Verified product reviews subcollection."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders routed to traders."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderLineItem" },
      "description": "Line items belonging to an order."
    },
    "/wishlists/{wishlistId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist items."
    },
    "/negotiations/{negotiationId}": {
      "schema": { "$ref": "#/entities/NegotiationOffer" },
      "description": "Buyer-seller price negotiation offers."
    },
    "/groupBuys/{groupBuyId}": {
      "schema": { "$ref": "#/entities/GroupBuy" },
      "description": "Community group buying deals."
    },
    "/groupBuys/{groupBuyId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/GroupBuyParticipant" },
      "description": "Participants joined in a group buy."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Direct buyer-seller chat messages."
    },
    "/files/{fileId}": {
      "schema": { "$ref": "#/entities/StorageFile" },
      "description": "Uploaded file metadata records."
    },
    "/rewards/{userId}": {
      "schema": { "$ref": "#/entities/UserRewards" },
      "description": "Bridge loyalty points per user."
    },
    "/liveStreams/{streamId}": {
      "schema": { "$ref": "#/entities/LiveStream" },
      "description": "Seller live selling streams."
    },
    "/liveStreams/{streamId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/LiveStreamMessage" },
      "description": "Live Q&A messages inside a livestream."
    },
    "/fraudAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/FraudAlert" },
      "description": "Platform fraud detection alerts managed by admin."
    }
  }
}
