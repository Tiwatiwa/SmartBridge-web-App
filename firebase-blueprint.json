{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized platform administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public storefront and marketplace identity for a user or trader without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["customer", "trader", "admin"]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "businessName": {
          "type": "string",
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "isFarmer": {
          "type": "boolean"
        },
        "verifiedBusiness": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "role", "location", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing user email and contact details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace product listing owned by a trader or reseller.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "traderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "price": {
          "type": "number"
        },
        "originalPrice": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "maxLength": 1200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "listingType": {
          "type": "string",
          "enum": ["new", "rent", "resell", "farm_direct", "clearance"]
        },
        "stockQty": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "businessName", "location", "name", "price", "category", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order routed to a seller.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "traderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "totalAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Preparing", "Out for Delivery", "Delivered"]
        },
        "paymentMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "deliveryPin": {
          "type": "string",
          "maxLength": 8
        },
        "privacyConsent": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["customerId", "customerName", "customerLocation", "traderId", "businessName", "totalAmount", "status", "paymentMethod", "privacyConsent", "createdAt"]
    },
    "OrderLineItem": {
      "title": "OrderLineItem",
      "description": "Line item subcollection document belonging to an order.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "price": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        }
      },
      "required": ["orderId", "productId", "productName", "price", "quantity"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer rating and review for a marketplace product.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productId", "customerId", "customerName", "rating", "comment", "createdAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved product in a user's personal wishlist.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "productId", "createdAt"]
    },
    "NegotiationOffer": {
      "title": "NegotiationOffer",
      "description": "Customer price negotiation offer with a seller.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "traderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listedPrice": {
          "type": "number"
        },
        "offerPrice": {
          "type": "number"
        },
        "counterPrice": {
          "type": "number"
        },
        "message": {
          "type": "string",
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Accepted", "Countered", "Declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productId", "productName", "traderId", "customerId", "listedPrice", "offerPrice", "status", "createdAt"]
    },
    "GroupBuy": {
      "title": "GroupBuy",
