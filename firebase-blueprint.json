    },
    "GroupBuyParticipant": {
      "title": "GroupBuyParticipant",
      "description": "Participant subcollection record in a community group buy.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "qty": {
          "type": "number"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "userName", "qty", "joinedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Direct buyer-to-seller message.",
