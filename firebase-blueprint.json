        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fileSize": {
          "type": "number"
        },
        "fileType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "filePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "fileName", "fileSize", "fileType", "filePath", "createdAt"]
    },
    "UserRewards": {
      "title": "UserRewards",
      "description": "Bridge loyalty points and tier status per customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
